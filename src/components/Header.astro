---
/**
 * Site header: logo · About Us · Events · Contact (three dropdowns,
 * NavDropdown.astro) · Join. Each dropdown opens on hover, click/tap and
 * keyboard; without JS its label is a plain link to the page.
 * Phones: logo, Join and a menu button (≡, turns into ✕) that drops a small
 * panel under the header: the five pages and the email. The page stays in
 * view, dimmed; a tap on it, Esc or a link closes the menu. Without JS the
 * menu button is a link to the footer navigation. Behavior lives in
 * src/scripts/site.ts.
 */
import { copy } from '../content/copy';
import { site } from '../lib/data';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import NavDropdown, { type Dropdown } from './NavDropdown.astro';

interface Props {
  path: string;
}
const { path } = Astro.props;

const m = copy.nav.menus;
const menus: Dropdown[] = [
  { id: 'about', label: copy.nav.about, href: '/about', ...m.about },
  { id: 'events', label: copy.nav.events, href: '/events', ...m.events },
  {
    id: 'contact',
    label: copy.nav.contact,
    href: '/contact',
    eyebrow: m.contact.eyebrow,
    items: [...m.contact.items, { href: `mailto:${site.contact_email}`, title: m.contact.email, body: site.contact_email }],
  },
];
// Phone menu: the pages only. Join stays in the header; sections are a scroll away.
const phonePages = [
  { href: '/about', label: copy.nav.about },
  { href: '/events', label: copy.nav.events },
  { href: '/team', label: copy.nav.team },
  { href: '/advisory-board', label: copy.nav.board },
  { href: '/contact', label: copy.nav.contact },
];
const current = (href: string) => (!href.includes('#') && path === href ? 'page' : undefined);
---

<header class="site-header" data-header>
  <div class="container site-header__row">
    <a href="/" class="site-header__home" aria-current={current('/')}>
      <Logo animate class="site-header__logo" />
    </a>

    <nav class="site-nav" aria-label={copy.nav.primaryLabel}>
      <ul>
        {menus.map((menu) => <NavDropdown menu={menu} path={path} />)}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="btn btn--primary btn--sm site-header__join" href="/join" aria-current={current('/join')}>{copy.nav.join}</a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu-panel" data-menu-toggle>
        <svg class="menu-btn__icon" viewBox="0 0 16 16" width="20" height="20" aria-hidden="true" focusable="false">
          <path class="menu-btn__line menu-btn__line--top" d="M2.5 5.5h11"></path>
          <path class="menu-btn__line menu-btn__line--bottom" d="M2.5 10.5h11"></path>
        </svg>
        <span class="visually-hidden">{copy.nav.menu}</span>
      </button>
      <a class="menu-btn menu-btn--fallback" href="#site-footer">
        <Icon name="menu" />
        <span class="visually-hidden">{copy.nav.menu}</span>
      </a>
    </div>
  </div>

  <nav id="menu-panel" class="menu-panel" data-theme="paper" aria-label={copy.nav.menu} data-menu>
    <ul>
      {
        phonePages.map((p) => (
          <li>
            <a class="menu-panel__link" href={p.href} aria-current={current(p.href)}>
              <span>{p.label}</span>
              <Icon name="arrow" />
            </a>
          </li>
        ))
      }
    </ul>
    <a class="menu-panel__email data" href={`mailto:${site.contact_email}`}>{site.contact_email}</a>
  </nav>
</header>
<div class="menu-scrim" aria-hidden="true" data-menu-scrim></div>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--header-h);
    display: flex;
    align-items: center;
    background: color-mix(in srgb, var(--brand-ivory) 86%, transparent);
    -webkit-backdrop-filter: saturate(1.6) blur(16px);
    backdrop-filter: saturate(1.6) blur(16px);
    border-bottom: 1px solid color-mix(in srgb, var(--line) 0%, transparent);
    transition:
      height 0.35s var(--ease-out),
      border-color 0.35s,
      background-color 0.35s;
  }
  .site-header.is-compact {
    height: var(--header-compact);
    border-bottom-color: var(--line);
    background: color-mix(in srgb, var(--brand-ivory) 92%, transparent);
  }
  .site-header__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .site-header__home {
    display: block;
    border-radius: 4px;
  }
  .site-header__home :global(.site-header__logo) {
    width: 138px;
    transition: width 0.35s var(--ease-out);
  }
  .is-compact .site-header__home :global(.site-header__logo) {
    width: 124px;
  }
  @media (min-width: 900px) {
    .site-header__home :global(.site-header__logo) {
      width: 156px;
    }
    .is-compact .site-header__home :global(.site-header__logo) {
      width: 132px;
    }
  }

  .site-nav {
    display: none;
  }
  .site-nav > ul {
    display: flex;
    gap: 4px;
  }
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .menu-btn {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--ink);
  }
  .menu-btn svg {
    width: 20px;
    height: 20px;
  }
  /* Hover only where there is a real pointer: a tap would leave it on. */
  @media (hover: hover) {
    .menu-btn:hover {
      background: var(--surface-sunk);
    }
  }
  .menu-btn__line {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.3s var(--ease-out);
  }
  /* ≡ folds into ✕ while the menu is open. */
  .menu-btn[aria-expanded='true'] .menu-btn__line--top {
    transform: translateY(2.5px) rotate(45deg);
  }
  .menu-btn[aria-expanded='true'] .menu-btn__line--bottom {
    transform: translateY(-2.5px) rotate(-45deg);
  }
  :global(.js) .menu-btn--fallback {
    display: none;
  }
  :global(html:not(.js)) [data-menu-toggle] {
    display: none;
  }

  @media (min-width: 900px) {
    .site-nav {
      display: block;
      margin-left: auto;
    }
    .menu-btn {
      display: none !important;
    }
  }

  /* ── phone menu: a panel under the header ─────────────────────── */
  /* Hangs below the header (so it follows the compact height), lined up
     with the menu button. Closed = invisible and unfocusable. */
  .menu-panel {
    position: absolute;
    top: calc(100% + 8px);
    right: var(--gutter);
    width: min(calc(100% - 2 * var(--gutter)), 360px);
    padding: 8px;
    border-radius: var(--radius-md);
    background: var(--surface-raised);
    color: var(--ink);
    box-shadow:
      0 0 0 1px var(--line),
      var(--shadow-panel);
    visibility: hidden;
    opacity: 0;
    transform: translateY(-8px);
    transition:
      opacity 0.18s ease,
      transform 0.25s var(--ease-out),
      visibility 0s linear 0.25s;
  }
  :global(.menu-open) .menu-panel {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition:
      opacity 0.18s ease,
      transform 0.25s var(--ease-out),
      visibility 0s;
  }
  .menu-panel ul {
    display: grid;
    gap: 2px;
  }
  .menu-panel__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 48px;
    padding: 0 12px;
    border-radius: var(--radius-sm);
    font-weight: 600;
    font-size: 18px;
    letter-spacing: -0.01em;
    text-decoration: none;
    color: var(--ink);
  }
  .menu-panel__link:hover,
  .menu-panel__link:focus-visible {
    background: var(--surface-sunk);
  }
  .menu-panel__link:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: -2px;
  }
  .menu-panel__link svg {
    width: 16px;
    height: 16px;
    color: var(--ink-muted);
  }
  /* The page you are on: the spark dot, as in the desktop menus. */
  .menu-panel__link[aria-current='page'] span::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    margin: 0 10px 3px 0;
    border-radius: 50%;
    background: var(--spark);
  }
  .menu-panel__email {
    display: block;
    margin: 8px 4px 0;
    padding: 14px 8px;
    border-top: 1px solid var(--divider);
    color: var(--ink-muted);
  }

  /* Dims the page behind the open menu; a tap on it closes the menu. */
  .menu-scrim {
    position: fixed;
    inset: 0;
    z-index: 49;
    background: color-mix(in srgb, var(--brand-black) 30%, transparent);
    visibility: hidden;
    opacity: 0;
    transition:
      opacity 0.25s ease,
      visibility 0s linear 0.25s;
  }
  :global(.menu-open) .menu-scrim {
    visibility: visible;
    opacity: 1;
    transition:
      opacity 0.25s ease,
      visibility 0s;
  }
  @media (min-width: 900px) {
    .menu-panel,
    .menu-scrim {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .menu-panel,
    .menu-scrim,
    .menu-btn__line {
      transform: none;
      transition: none;
    }
    .menu-btn[aria-expanded='true'] .menu-btn__line--top {
      transform: translateY(2.5px) rotate(45deg);
    }
    .menu-btn[aria-expanded='true'] .menu-btn__line--bottom {
      transform: translateY(-2.5px) rotate(-45deg);
    }
  }
</style>
