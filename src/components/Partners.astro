---
/** Partner names in a hairline grid, like a data strip. Logos can replace the names later. */
import { site } from '../lib/data';
// One row up to 5 names; 6 or more wrap into even rows of 3 or 4.
const n = site.partners.length;
const cols = n <= 5 ? n : n % 3 === 0 ? 3 : 4;
---

<ul class="partners" role="list" style={`--n:${cols}`}>
  {
    site.partners.map((p, i) => (
      <li class="partners__cell" data-row-start={i % cols === 0 ? '' : undefined} data-reveal>
        <p class="partners__name">
          {p.link ? (
            <a href={p.link} target="_blank" rel="noopener">
              {p.name}
            </a>
          ) : (
            p.name
          )}
        </p>
        <p class="label">{p.kind}</p>
      </li>
    ))
  }
</ul>

<style>
  .partners {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: var(--stroke-rule) solid var(--ink);
  }
  .partners__cell {
    display: grid;
    gap: 8px;
    align-content: start;
    padding: 20px 16px 22px;
    border-bottom: 1px solid var(--divider);
  }
  .partners__cell:nth-child(odd) {
    padding-left: 0;
  }
  .partners__cell:nth-child(even) {
    border-left: 1px solid var(--divider);
  }
  /* An odd last name on phones takes the full row. */
  @media (max-width: 899px) {
    .partners__cell:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 900px) {
    .partners {
      grid-template-columns: repeat(var(--n, 3), minmax(0, 1fr));
    }
    .partners__cell {
      padding: 28px 24px 30px;
    }
    .partners__cell:nth-child(odd) {
      padding-left: 24px;
    }
    .partners__cell:nth-child(even) {
      border-left: 0;
    }
    .partners__cell:nth-child(n) {
      padding-left: 24px;
      border-left: 1px solid var(--divider);
    }
    .partners__cell[data-row-start]:nth-child(n) {
      padding-left: 0;
      border-left: 0;
    }
  }
  .partners__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.125rem, 1rem + 0.7vw, 1.625rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .partners__name a {
    text-decoration: none;
  }
</style>
