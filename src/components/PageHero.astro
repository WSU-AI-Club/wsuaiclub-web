---
/**
 * Hero for inner pages: label row with the accent spark, a 3px rule, a big
 * headline and a lede. Optional slot below for buttons, a strip or a photo.
 */
import Spark from './Spark.astro';
interface Props {
  eyebrow: string;
  headline: string;
  lede?: string;
  theme?: 'paper' | 'ink';
  index?: string;
}
const { eyebrow, headline, lede, theme = 'paper', index } = Astro.props;
---

<section class="page-hero" data-theme={theme}>
  <div class="container">
    <div class="page-hero__bar enter">
      <p class="eyebrow kicker"><Spark />{eyebrow}</p>
      {index && <p class="eyebrow" aria-hidden="true">{index}</p>}
    </div>
    <div class="page-hero__body enter">
      <h1 class="display">{headline}</h1>
      {lede && <p class="lede">{lede}</p>}
    </div>
    <slot />
  </div>
</section>

<style>
  .page-hero {
    padding-block: clamp(40px, 7vw, 96px) clamp(48px, 8vw, 112px);
  }
  .page-hero__bar {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 14px;
    border-bottom: var(--stroke-rule) solid var(--ink);
    margin-bottom: clamp(28px, 4.5vw, 56px);
  }
  .page-hero__body {
    display: grid;
    gap: 20px;
  }
  .page-hero .display {
    max-width: 14ch;
  }
  @media (min-width: 1024px) {
    .page-hero__body {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: 56px;
      align-items: end;
    }
    .page-hero .display {
      max-width: none;
    }
  }
</style>
