---
/**
 * The semester in numbers, laid out like the RecapPost: big Geist numbers
 * over mono labels in a hairline grid. Numbers count up once (site.ts).
 * Values and labels: src/data/site.yaml > stats.
 */
import { site } from '../lib/data';
import SectionHead from './SectionHead.astro';
interface Props {
  eyebrow: string;
  headline: string;
  index?: string;
}
const { eyebrow, headline, index } = Astro.props;
const s = site.stats;
---

<section class="section stats" data-theme="ink" aria-labelledby="stats-title">
  <div class="container">
    <SectionHead eyebrow={`${eyebrow} · ${s.term}`} index={index} headline={headline} lede={s.note} id="stats-title" />
    <dl class="stats__grid">
      {
        s.items.map((item) => (
          <div class="stats__cell" data-reveal>
            <dt class="label">{item.label}</dt>
            <dd class="stats__value">
              {item.prefix && <span class="stats__prefix">{item.prefix}</span>}
              <span data-count={item.value}>{item.value}</span>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .stats__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: var(--stroke-rule) solid var(--ink);
  }
  .stats__cell {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 10px;
    padding: 20px 16px 24px;
    border-bottom: 1px solid var(--divider);
  }
  .stats__cell:nth-child(2n + 1) {
    padding-left: 0;
  }
  .stats__cell:nth-child(2n) {
    border-left: 1px solid var(--divider);
  }
  @media (min-width: 900px) {
    .stats__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .stats__cell {
      padding: 28px 28px 32px;
    }
    .stats__cell:nth-child(2n + 1) {
      padding-left: 28px;
    }
    .stats__cell:nth-child(2n) {
      border-left: 0;
    }
    .stats__cell:nth-child(3n + 1) {
      padding-left: 0;
    }
    .stats__cell:not(:nth-child(3n + 1)) {
      border-left: 1px solid var(--divider);
    }
  }
  .stats__value {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(3.5rem, 2rem + 7vw, 8rem);
    line-height: 0.88;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
  }
  .stats__prefix {
    margin-right: -0.04em;
  }
  .stats .label {
    max-width: 22ch;
  }
</style>
