---
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import { copy } from '../content/copy';
import { site } from '../lib/data';
import Base from '../layouts/Base.astro';

const j = copy.join;
const c = j.channels;
const channels = [
  { ...c.shockersync, href: site.links.shockersync },
  { ...c.groupme, href: site.links.groupme },
  { ...c.email, href: site.links.email_list },
  { ...c.instagram, href: site.links.instagram },
  { ...c.linkedin, href: site.links.linkedin },
];
const ext = { target: '_blank', rel: 'noopener' };
---

<Base title={copy.meta.join.title} description={copy.meta.join.description} path="/join">
  <PageHero eyebrow={j.hero.eyebrow} headline={j.hero.headline} lede={j.hero.lede}>
    <ul class="channels" role="list">
      {
        channels.map((ch, i) => (
          <li class="card channel" data-theme="paper" data-reveal>
            <div class="card__body">
              <div class="channel__top">
                <p class="eyebrow">{ch.eyebrow}</p>
                <p class="eyebrow" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
              </div>
              <h2 class="title channel__title">
                <a class="stretch" href={ch.href} {...ext}>
                  {ch.title}
                  <span class="visually-hidden">{` ${copy.newTab}`}</span>
                </a>
              </h2>
              <p class="body">{ch.body}</p>
              <p class="card__foot">
                <span class="more">
                  <span>{ch.cta}</span>
                  <Icon name="external" />
                </span>
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </PageHero>

</Base>

<style>
  .channels {
    display: grid;
    gap: 12px;
    margin-top: clamp(32px, 5vw, 56px);
  }
  @media (min-width: 640px) {
    .channels {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }
    .channel:last-child {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 900px) {
    .channels {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    .channel {
      grid-column: span 2;
    }
    .channel:nth-child(4),
    .channel:nth-child(5) {
      grid-column: span 3;
    }
  }
  @media (min-width: 1200px) {
    .channels {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 20px;
    }
    .channel,
    .channel:nth-child(4),
    .channel:nth-child(5),
    .channel:last-child {
      grid-column: auto;
    }
  }
  .channel .card__body {
    gap: 8px;
  }
  .channel__top {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  .channel__title {
    font-size: clamp(1.375rem, 1.2rem + 0.6vw, 1.75rem);
    letter-spacing: -0.025em;
  }
  .channel__title a {
    color: inherit;
  }
</style>
