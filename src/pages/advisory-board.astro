---
import Icon from '../components/Icon.astro';
import JoinBand from '../components/JoinBand.astro';
import PageHero from '../components/PageHero.astro';
import PersonCard from '../components/PersonCard.astro';
import PersonGrid from '../components/PersonGrid.astro';
import SectionHead from '../components/SectionHead.astro';
import { copy } from '../content/copy';
import { advisoryBoard } from '../lib/data';
import Base from '../layouts/Base.astro';

const b = copy.board;
const people = advisoryBoard?.people ?? [];
---

<Base title={copy.meta.board.title} description={copy.meta.board.description} path="/advisory-board">
  <PageHero eyebrow={b.hero.eyebrow} headline={b.hero.headline} lede={b.hero.lede} index={`${String(people.length).padStart(2, '0')} members`} />

  <section class="section section--tight" data-theme="paper" aria-label={b.hero.eyebrow}>
    <div class="container">
      <PersonGrid>
        {people.map((p) => <PersonCard person={p} />)}
      </PersonGrid>
    </div>
  </section>

  <section class="section" data-theme="paper" aria-labelledby="board-contact-title">
    <div class="container">
      <SectionHead eyebrow={b.contact.eyebrow} index="01" headline={b.contact.headline} lede={b.contact.lede} id="board-contact-title">
        <a class="btn btn--primary" href="/contact">{b.contact.cta}<Icon name="arrow" /></a>
      </SectionHead>
    </div>
  </section>

  <JoinBand />
</Base>
