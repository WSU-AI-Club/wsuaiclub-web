---
import Icon from '../components/Icon.astro';
import JoinBand from '../components/JoinBand.astro';
import PageHero from '../components/PageHero.astro';
import PersonCard from '../components/PersonCard.astro';
import PersonGrid from '../components/PersonGrid.astro';
import { copy } from '../content/copy';
import { team } from '../lib/data';
import Base from '../layouts/Base.astro';

const t = copy.team;
// The industry advisory board has its own page; Team ends with a link to it.
const groups = team.groups.filter((g) => !/advisory/i.test(g.name));
const slug = (s: string) =>
  s
    .toLowerCase()
    .replace(/&/g, 'and')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
---

<Base title={copy.meta.team.title} description={copy.meta.team.description} path="/team">
  <PageHero eyebrow={t.hero.eyebrow} headline={t.hero.headline} lede={t.hero.lede} />

  {
    groups.map((g, i) => (
      <section class="section section--tight team-group" data-theme="paper" aria-labelledby={`g-${slug(g.name)}`}>
        <div class="container">
          <div class="team-group__bar" data-reveal>
            <h2 class="title title--lg" id={`g-${slug(g.name)}`}>
              {g.name}
            </h2>
            <p class="eyebrow">
              {String(i + 1).padStart(2, '0')} · {g.people.length} {g.people.length === 1 ? 'person' : 'people'}
            </p>
          </div>
          {g.note && (
            <p class="lede team-group__note" data-reveal>
              {g.note}
            </p>
          )}
          <PersonGrid solo={g.people.length === 1}>
            {g.people.map((p) => (
              <PersonCard person={p} />
            ))}
          </PersonGrid>
        </div>
      </section>
    ))
  }

  <section class="section section--tight team-group" data-theme="paper">
    <div class="container">
      <p data-reveal>
        <a class="btn btn--primary" href="/advisory-board">
          {copy.board.teamLink}
          <Icon name="arrow" />
        </a>
      </p>
    </div>
  </section>

  <JoinBand />
</Base>

<style>
  .team-group {
    padding-top: 0;
  }
  .team-group__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 24px;
    padding-bottom: 14px;
    border-bottom: var(--stroke-rule) solid var(--ink);
    margin-bottom: 24px;
  }
  .team-group__note {
    margin: -4px 0 24px;
  }
</style>
