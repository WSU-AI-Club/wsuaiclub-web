---
import FormatCards from '../components/FormatCards.astro';
import Hackathons from '../components/Hackathons.astro';
import Icon from '../components/Icon.astro';
import JoinBand from '../components/JoinBand.astro';
import Partners from '../components/Partners.astro';
import SectionHead from '../components/SectionHead.astro';
import Slideshow from '../components/Slideshow.astro';
import Spark from '../components/Spark.astro';
import { copy } from '../content/copy';
import { site } from '../lib/data';
import type { PhotoName } from '../lib/photo-meta';
import Base from '../layouts/Base.astro';

const h = copy.home;
const heroPhotos: PhotoName[] = ['barton-atrium-group', 'chocolathon-auditorium', 'classroom-group', 'chatterbox-demo', 'glass-wall-visit', 'lovable-workshop', 'groover-labs-speaker'];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'AI Club at Wichita State',
  alternateName: 'WSU AI Club',
  url: 'https://www.wsuaiclub.com/',
  logo: 'https://www.wsuaiclub.com/apple-touch-icon.png',
  email: site.contact_email,
  description: copy.meta.home.description,
  sameAs: [site.links.instagram, site.links.linkedin, site.links.shockersync],
  parentOrganization: { '@type': 'CollegeOrUniversity', name: 'Wichita State University' },
};
---

<Base title={copy.meta.home.title} description={copy.meta.home.description} path="/" jsonLd={jsonLd}>
  <section class="hero" data-theme="paper" aria-labelledby="hero-title">
    <div class="container hero__grid">
      <div class="hero__copy enter">
        <p class="eyebrow kicker"><Spark />{h.hero.eyebrow}</p>
        <h1 class="display hero__title" id="hero-title">{h.hero.headline}</h1>
        <p class="lede">{h.hero.lede}</p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/join">{h.hero.primary}<Icon name="arrow" /></a>
          <a class="btn btn--secondary" href="/events">{h.hero.secondary}</a>
        </div>
      </div>
      <Slideshow
        class="hero__show"
        photos={heroPhotos}
        label={copy.slideshow.home}
        priority
        sizes="(min-width: 1440px) 624px, (min-width: 1024px) 46vw, calc(100vw - 32px)"
        widths={[480, 640, 960, 1280, 1600]}
      />
    </div>
  </section>

  <section class="section" data-theme="paper" aria-labelledby="formats-title">
    <div class="container">
      <SectionHead eyebrow={h.formats.eyebrow} index="01 / 03" headline={h.formats.headline} lede={h.formats.lede} id="formats-title" />
      <FormatCards />
    </div>
  </section>

  <section class="section" data-theme="paper" aria-labelledby="hack-title">
    <div class="container">
      <SectionHead eyebrow={h.hackathons.eyebrow} index="02 / 03" headline={h.hackathons.headline} lede={h.hackathons.lede} id="hack-title" />
      <Hackathons />
    </div>
  </section>

  <section class="section" data-theme="paper" aria-labelledby="partners-title">
    <div class="container">
      <SectionHead eyebrow={h.partners.eyebrow} index="03 / 03" headline={h.partners.headline} lede={h.partners.lede} id="partners-title" />
      <Partners />
    </div>
  </section>

  <JoinBand />
</Base>

<style>
  /* ── hero: copy, then a contained slideshow (side by side on desktop) ── */
  .hero {
    padding-block: clamp(28px, 5vw, 80px) clamp(40px, 6vw, 88px);
  }
  .hero__grid {
    display: grid;
    gap: 32px;
  }
  .hero__copy {
    display: grid;
    gap: 18px;
    justify-items: start;
  }
  .hero__title {
    max-width: 11ch;
  }
  .hero .lede {
    max-width: 26em;
  }
  .hero .btn-row {
    margin-top: 6px;
  }
  .hero :global(.hero__show) {
    aspect-ratio: 4 / 3;
  }
  @media (min-width: 1024px) {
    .hero__grid {
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
      gap: 56px;
      align-items: center;
    }
    .hero__title {
      max-width: none;
    }
    .hero :global(.hero__show) {
      aspect-ratio: 5 / 4;
      max-height: 560px;
    }
  }

</style>
