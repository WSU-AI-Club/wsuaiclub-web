---
import Avatar from '../components/Avatar.astro';
import FormatCards from '../components/FormatCards.astro';
import Hackathons from '../components/Hackathons.astro';
import Icon from '../components/Icon.astro';
import JoinBand from '../components/JoinBand.astro';
import Name from '../components/Name.astro';
import NextMeeting from '../components/NextMeeting.astro';
import Partners from '../components/Partners.astro';
import Photo from '../components/Photo.astro';
import SectionHead from '../components/SectionHead.astro';
import Spark from '../components/Spark.astro';
import Stats from '../components/Stats.astro';
import { copy } from '../content/copy';
import { officersWithPhotos, site, teamCounts } from '../lib/data';
import Base from '../layouts/Base.astro';

const h = copy.home;
const teamLine = `${teamCounts.officers} student officers, ${teamCounts.faculty === 1 ? 'a faculty advisor' : `${teamCounts.faculty} faculty advisors`} and ${teamCounts.advisors} industry advisors.`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'AI Club at Wichita State',
  alternateName: 'WSU AI Club',
  url: 'https://www.wsuaiclub.com/',
  logo: 'https://www.wsuaiclub.com/apple-touch-icon.png',
  email: site.contact_email,
  description: copy.meta.home.description,
  sameAs: [site.links.instagram, site.links.linkedin, site.links.shockersync],
  parentOrganization: { '@type': 'CollegeOrUniversity', name: 'Wichita State University' },
};
---

<Base title={copy.meta.home.title} description={copy.meta.home.description} path="/" jsonLd={jsonLd}>
  <section class="hero" data-theme="ink" aria-labelledby="hero-title">
    <div class="container hero__grid">
      <div class="hero__copy enter">
        <p class="eyebrow kicker"><Spark />{h.hero.eyebrow}</p>
        <h1 class="display hero__title" id="hero-title">{h.hero.headline}</h1>
        <p class="lede">{h.hero.lede}</p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/join">{h.hero.primary}<Icon name="arrow" /></a>
          <a class="btn btn--secondary" href="/events">{h.hero.secondary}</a>
        </div>
      </div>
      <figure class="hero__media">
        <div class="hero__frame scrim">
          <div class="hero__parallax" data-parallax="56">
            <Photo
              name="barton-atrium-group"
              priority
              sizes="(min-width: 1024px) 56vw, 100vw"
              widths={[640, 960, 1280, 1600, 2000, 2400]}
            />
          </div>
        </div>
      </figure>
    </div>
    <div class="container hero__strip">
      <NextMeeting />
    </div>
  </section>

  <section class="section" data-theme="paper" aria-labelledby="formats-title">
    <div class="container">
      <SectionHead eyebrow={h.formats.eyebrow} index="01 / 05" headline={h.formats.headline} lede={h.formats.lede} id="formats-title" />
      <FormatCards />
    </div>
  </section>

  <Stats eyebrow={h.numbers.eyebrow} headline={h.numbers.headline} index="02 / 05" />

  <section class="section" data-theme="paper" aria-labelledby="hack-title">
    <div class="container">
      <SectionHead eyebrow={h.hackathons.eyebrow} index="03 / 05" headline={h.hackathons.headline} lede={h.hackathons.lede} id="hack-title" />
      <Hackathons />
    </div>
  </section>

  <section class="section" data-theme="paper" aria-labelledby="partners-title">
    <div class="container">
      <SectionHead eyebrow={h.partners.eyebrow} index="04 / 05" headline={h.partners.headline} lede={h.partners.lede} id="partners-title" />
      <Partners />
    </div>
  </section>

  <section class="section" data-theme="paper" aria-labelledby="team-title">
    <div class="container">
      <SectionHead eyebrow={h.team.eyebrow} index="05 / 05" headline={h.team.headline} lede={teamLine} id="team-title">
        <a class="btn btn--primary" href="/team">{h.team.cta}<Icon name="arrow" /></a>
      </SectionHead>
      <ul class="faces" role="list" data-reveal>
        {
          officersWithPhotos.map((p) => (
            <li class="faces__item">
              <Avatar name={p.name} photo={p.photo} size={112} />
              <p class="faces__name"><Name name={p.name} /></p>
              {p.role && <p class="label">{p.role}</p>}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <JoinBand />
</Base>

<style>
  /* ── hero ─────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    overflow: clip;
    padding-top: clamp(28px, 5vw, 72px);
  }
  .hero__grid {
    display: grid;
  }
  .hero__copy {
    display: grid;
    gap: 18px;
    justify-items: start;
    padding-bottom: 32px;
  }
  .hero__title {
    max-width: 11ch;
  }
  .hero .lede {
    max-width: 26em;
  }
  .hero .btn-row {
    margin-top: 6px;
  }
  .hero__media {
    margin-inline: calc(-1 * var(--gutter));
  }
  .hero__frame {
    position: relative;
    aspect-ratio: 6 / 5;
    overflow: hidden;
    background: var(--surface-raised);
  }
  .hero__frame.scrim::after {
    background: linear-gradient(180deg, rgba(11, 11, 12, 0.1) 0%, rgba(11, 11, 12, 0) 35%, rgba(11, 11, 12, 0) 62%, rgba(11, 11, 12, 0.96) 100%);
  }
  .hero__parallax {
    position: absolute;
    inset: 0;
    will-change: transform;
  }
  .hero__parallax :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__strip {
    position: relative;
    z-index: 1;
    margin-top: -36px;
    padding-bottom: clamp(32px, 5vw, 56px);
  }
  @media (min-width: 640px) {
    .hero__frame {
      aspect-ratio: 16 / 10;
    }
  }
  @media (min-width: 1024px) {
    .hero {
      padding-top: clamp(48px, 6vw, 88px);
    }
    .hero__grid {
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
      gap: 48px;
      align-items: end;
    }
    .hero__copy {
      padding-bottom: 48px;
    }
    .hero__title {
      max-width: none;
    }
    .hero__media {
      margin-inline: 0 calc(-1 * max(var(--gutter), (100vw - var(--max)) / 2));
    }
    .hero__frame {
      aspect-ratio: 1.24;
      max-height: 640px;
      width: 100%;
      border-radius: var(--radius-md) 0 0 var(--radius-md);
    }
    .hero__frame.scrim::after {
      background: linear-gradient(180deg, rgba(11, 11, 12, 0) 55%, rgba(11, 11, 12, 0.7) 100%);
    }
    .hero__strip {
      margin-top: 40px;
    }
  }

  /* ── team preview ─────────────────────────────────────────────── */
  /* Phones: an overlapping row of faces. 640px and up: a grid with names. */
  .faces {
    display: flex;
    padding-left: 12px;
  }
  .faces__item {
    margin-left: -12px;
  }
  .faces__item :global(.avatar) {
    --size: 58px !important;
    box-shadow: 0 0 0 3px var(--surface);
  }
  .faces__name,
  .faces__item .label {
    position: absolute !important;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  @media (min-width: 640px) {
    .faces {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 28px 16px;
      padding-left: 0;
    }
    .faces__item {
      display: grid;
      gap: 6px;
      align-content: start;
      justify-items: start;
      margin-left: 0;
    }
    .faces__item :global(.avatar) {
      --size: 96px !important;
      margin-bottom: 8px;
      box-shadow: none;
    }
    .faces__name,
    .faces__item .label {
      position: static !important;
      width: auto;
      height: auto;
      overflow: visible;
      clip: auto;
      white-space: normal;
    }
    .faces__name {
      font-family: var(--font-serif);
      font-size: 1.1875rem;
      line-height: 1.2;
    }
  }
  @media (min-width: 1024px) {
    .faces {
      grid-template-columns: repeat(8, minmax(0, 1fr));
      gap: 24px;
    }
    .faces__item :global(.avatar) {
      --size: 112px !important;
    }
  }
</style>
